# Copy this file to .env and fill it in. Never commit or zip the real .env.

# Which LLM parses the question: "azure" (default) or "anthropic".
LLM_PROVIDER=azure

# --- Azure OpenAI (default) ---
AZURE_OPENAI_API_KEY=
# e.g. https://<your-resource>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Anthropic (only if LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional. Folder with the five source files. Default: fixtures/data-engineering-v3
CORPUS_DIR=
